[Unit]
Description=rekt-snapshot: nightly consistent copy of the database
After=rekt-watch.service

[Service]
Type=oneshot
User=rekt
Group=rekt
WorkingDirectory=/home/rekt/rekt
EnvironmentFile=/home/rekt/rekt/.env
# VACUUM INTO writes a consistent snapshot while the watcher keeps writing (WAL). Seven kept.
ExecStart=/bin/sh /home/rekt/rekt/deploy/snapshot.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rekt-snapshot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rekt/rekt/data

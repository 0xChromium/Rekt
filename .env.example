# --- RPC ---------------------------------------------------------------------
# eth_getLogs only works on the official RPC. It is rate limited: LOGS_SPACING_MS is the gap between reads.
RPC_LOGS_URL=https://rpc.mainnet.chain.robinhood.com
# State reads and the websocket go to publicnode, which refuses eth_getLogs.
RPC_STATE_URL=https://robinhood-rpc.publicnode.com
RPC_WS_URL=wss://robinhood-rpc.publicnode.com
LOGS_SPACING_MS=400

# --- storage and web ---------------------------------------------------------
DB_PATH=data/rekt.db
PORT=8787
PUBLIC_URL=http://localhost:8787

# --- the token ---------------------------------------------------------------
# Empty means no CA yet: every surface says "boarding soon".
REKT_TOKEN=
# The creator fee recipient before the splitter is live, and the team's half after.
FEE_WALLET=
TEAM_WALLET=
# Empty until the contracts are deployed (ROADMAP.md item 0).
SPLITTER=
STAKING=

# 1 while building: static files are cached for a minute instead of a day.
DEV=0
